# Local Vaultwarden Configuration
LOCAL_VAULTWARDEN_URL=http://your-vaultwarden-server:8080
LOCAL_VAULTWARDEN_EMAIL=your-email@example.com
LOCAL_MASTER_PASSWORD=your_local_master_password

# Bitwarden Cloud Configuration
CLOUD_MASTER_PASSWORD=your_cloud_master_password
BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Automation Settings (required for Docker/cron)
SKIP_CONFIRMATION=true

# Docker-specific Settings
# Cron schedule (default: daily at 2 AM)
# Examples: "0 2 * * *" (daily), "0 */6 * * *" (every 6 hours), "*/30 * * * *" (every 30 min for testing)
CRON_SCHEDULE=0 2 * * *

# Run backup immediately when container starts (true/false)
RUN_ON_STARTUP=false

